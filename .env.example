# Copia este archivo como .env y llena los valores. .env no se sube a GitHub.

# Cadena de conexión de MongoDB Atlas (Database → Connect → Drivers)
MONGODB_URI=mongodb+srv://USUARIO:CONTRASEÑA@cluster0.xxxxx.mongodb.net/gestor_productos?retryWrites=true&w=majority

# Secreto para firmar los JWT (mínimo 32 caracteres). Genera uno con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_EXPIRES_IN=2h

PORT=3000
NODE_ENV=development

# Administrador inicial (opcional): se crea al arrancar si no existe
ADMIN_NOMBRE=Administrador
ADMIN_CORREO=admin@gestor.test
ADMIN_PASSWORD=cambia-esta-contraseña-123

# Carga 10 productos de ejemplo a nombre del administrador si la colección está vacía
SEMBRAR_DATOS=true
