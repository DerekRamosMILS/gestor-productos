{
  "name": "gestor-productos",
  "version": "1.0.0",
  "description": "Aplicación web para gestionar productos con Node.js, Express, MongoDB (Mongoose), JWT y Jest. Actividad 4, Desarrollo Full Stack.",
  "main": "server.js",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:rutas": "jest tests/rutas",
    "test:cobertura": "jest --coverage"
  },
  "engines": {
    "node": ">=22.9"
  },
  "author": "Derek Joan Ramos del Ángel",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.1"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.2"
  }
}
